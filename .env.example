# The deployed Next.js backend (same repo, sibling folder: lumo-food-agent)
# For local dev against a laptop running `npm run dev`, use your LAN IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
# For the shared Vercel preview:
EXPO_PUBLIC_API_BASE_URL=https://lumo-food-agent.vercel.app

# Stripe publishable key. Safe to ship in the client — pair it with the
# STRIPE_SECRET_KEY set on the backend (Vercel env). Without this, the app
# will fall back to cash-on-delivery mode and skip the PaymentSheet.
# Use the same pk_test_... value that the web app uses so a single PI flow
# works across clients.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
